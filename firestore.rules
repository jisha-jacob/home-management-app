rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isApprovedParent() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/authorizedParents/$(request.auth.uid));
    }

    match /authorizedParents/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /{collection}/{document} {
      allow read, write: if isApprovedParent()
        && collection in [
          'chores',
          'todayTasks',
          'overrides',
          'meals',
          'mealFavorites',
          'resetSessions',
          'resetTasks',
          'completions',
          'members',
          'settings',
          'shoppingItems'
        ];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
